# === Telegram (required) ===
# Get from https://my.telegram.org
API_ID=
API_HASH=

# Get from @BotFather
BOT_TOKEN=

# Channel numeric ID (e.g. -1001234567890) or @username
CHANNEL_ID=

# === GitHub (optional but recommended) ===
# Classic PAT with public_repo scope — bumps rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=

# === Tuning (optional) ===
# Poll interval in seconds (default: 600 = 10 minutes)
POLL_INTERVAL=600

# Number of concurrent upload workers (default: 2)
NUM_WORKERS=2

# GitHub repository to monitor (default: j-hc/revanced-magisk-module)
GITHUB_REPO=j-hc/revanced-magisk-module
